<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PolyAmp</AssemblyName>
    <RootNamespace>Lad</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- сразу полная оптимизация: аудиоколбэк не должен ждать перекомпиляции на лету -->
    <TieredCompilation>false</TieredCompilation>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- сборка вместе со средой .NET: у пользователя ничего доустанавливать не нужно -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- при публикации всё приложение и среда .NET — один PolyAmp.exe; рядом только папки lib, licenses и ui -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- иконка exe (Проводник, панель задач, ярлыки); та же иконка встроена ресурсом для окон -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <!-- исходники сторонней библиотеки и её сборка — не часть проекта C# -->
    <DefaultItemExcludes>$(DefaultItemExcludes);third_party/**;namcore/**;vst3host/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Asio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="PolyAmp.app.ico" />
  </ItemGroup>

  <!-- Официальная библиотека NAM (собирается namcore/build.bat) в двух вариантах: с AVX2 и запасной без него.
       Без неё работают только модели A1 и LSTM. -->
  <ItemGroup>
    <Content Include="namcore/bin/namcore.dll" Condition="Exists('namcore/bin/namcore.dll')" Link="lib\namcore.dll" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="namcore/bin/namcore-sse2.dll" Condition="Exists('namcore/bin/namcore-sse2.dll')" Link="lib\namcore-sse2.dll" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- Хост плагинов VST3 (собирается vst3host/build.bat) -->
    <Content Include="vst3host/bin/vst3host.dll" Condition="Exists('vst3host/bin/vst3host.dll')" Link="lib\vst3host.dll" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Лицензия приложения и тексты лицензий сторонних компонентов — в каждой сборке, в папке licenses -->
  <ItemGroup>
    <Content Include="..\LICENSE" Link="licenses\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\THIRD_PARTY_NOTICES.md" Link="licenses\THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Интерфейс — общий с веб-версией, копируется рядом с exe -->
  <ItemGroup>
    <Content Include="..\public\**\*" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
